{
  "dataset": "saint-flickr",
  "method": "dp_mlp",
  "seed": 0,
  "device": "auto",
  "split_strategy": "native",
  "split_root": "data/inductive_splits",
  "multilabel": false,
  "parameters": {
    "epochs": 10,
    "batch_size": 512,
    "hidden_size": 128,
    "layers": 2,
    "dropout": 0.5,
    "weight_decay": 0.0,
    "learning_rate": 0.01,
    "noise_multiplier": 1.337891,
    "clip": 1.0,
    "delta": 1e-6
  }
}
