{
  "name": "depth_ablation",
  "defaults": {
    "epsilon": 8,
    "seed": 0,
    "lr": 0.01,
    "batch_size": 256,
    "epochs": 20,
    "dropout": 0.5,
    "mlp_hidden": 64,
    "gnn_hidden": 128,
    "degree_bound": 5,
    "bootstrap_resamples": 1000
  },
  "grid": {
    "dataset": ["ogbn-arxiv", "saint-yelp", "twitch-allbut2"]
  },
  "runs": [
    {
      "grid": {
        "method": ["dp_gnn_sage", "dp_gnn_gin"],
        "dpgnn_radius": [1, 2, 3]
      }
    },
    {
      "parameters": {
        "method": "progap"
      },
      "grid": {
        "progap_depth": [1, 2, 3]
      }
    }
  ]
}
