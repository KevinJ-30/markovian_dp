{
  "seed": 0,
  "device": "auto",
  "split_root": "data/inductive_splits",
  "protocol": {
    "epochs": 100,
    "split": [0.6, 0.2, 0.2],
    "private_training_graph": "train-induced partition only"
  },
  "datasets": ["reddit", "facebook", "cora-ml", "pubmed"],
  "methods": {
    "dpar": {
      "parameters": {
        "epochs": 100,
        "topk": 16,
        "sampled_train_nodes": 70,
        "dp_ppr": true,
        "dp_sgd": true
      }
    },
    "dp_mlp": {"parameters": {"epochs": 100, "batch_size": 256, "noise_multiplier": 1.0}},
    "mlp": {"parameters": {"epochs": 100}},
    "graphsage": {"parameters": {"epochs": 100}},
    "dp_gnn": {"adapter": "src.experiments.upstream.UpstreamBaseline"},
    "progap": {"adapter": "src.experiments.upstream.UpstreamBaseline"},
    "heterpoisson": {"adapter": "src.experiments.upstream.UpstreamBaseline"}
  }
}
