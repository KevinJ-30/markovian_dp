{
  "name": "sparse_ablation_remaining_seed0",
  "defaults": {
    "seed": 0,
    "epochs": 20,
    "dropout": 0.5,
    "mlp_hidden": 64,
    "gnn_hidden": 128,
    "weight_decay": 0.0,
    "bootstrap_resamples": 1000
  },
  "grid": {
    "dataset": ["ogbn-arxiv", "ogbn-products", "saint-reddit", "fb100-year-6"],
    "method": ["sparse_sage", "sparse_gin"],
    "epsilon": [1, 2, 5, 8],
    "batch_size": [256, 1024],
    "lr": [0.01, 0.001]
  },
  "runs": [
    {
      "parameters": {
        "p2": 0.1,
        "sparse_degree_cap": 5
      },
      "grid": {
        "sparse_radius": [1, 2, 3]
      }
    },
    {
      "parameters": {
        "sparse_radius": 1,
        "sparse_degree_cap": 5
      },
      "grid": {
        "p2": [0.05, 0.25, 0.5, 1.0]
      }
    },
    {
      "parameters": {
        "sparse_radius": 1,
        "p2": 0.1
      },
      "grid": {
        "sparse_degree_cap": [10, 20, 40]
      }
    }
  ]
}
