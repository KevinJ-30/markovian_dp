{
  "name": "main_r1_eps1258_tune",
  "gpus": "auto",
  "defaults": {
    "seed": 0,
    "epochs": 20,
    "dropout": 0.5,
    "weight_decay": 0.0,
    "mlp_hidden": 128,
    "gnn_hidden": 128,
    "degree_bound": 5,
    "bootstrap_resamples": 0,
    "split_root": "results/progap_hidden128_standard8_tuning_20261002T213302Z/split_cache"
  },
  "grid": {
    "dataset": ["ogbn-arxiv", "ogbn-products", "saint-reddit", "saint-yelp", "saint-amazon", "fb100-year-6", "mag-allbut2"],
